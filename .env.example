# OpenAI API key for asset generation
# Get yours at: https://platform.openai.com/api-keys
# Copy this file to .env and paste your key below
OPENAI_API_KEY=sk-...

# Supabase classroom MVP settings
# Use the project URL and publishable/anon key only.
# VITE_SUPABASE_URL must look like https://your-project-ref.supabase.co
# Do not add /rest/v1 to VITE_SUPABASE_URL. The Supabase SDK adds that path internally.
# Do not include masking text such as xxxx in the project ref.
# Never put a Supabase service role key or secret key in frontend env files.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
